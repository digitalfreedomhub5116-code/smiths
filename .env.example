# ==========================================
# SMITHS JEWELLERY - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your credentials.

# Supabase Project URL
VITE_SUPABASE_URL=https://znvqgluajmxgdvyfnkzu.supabase.co

# Supabase Anon Public API Key (JWT) or Modern Publishable Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-modern-publishable-key-here

# Razorpay Key ID (Prepaid UPI, QR & Cards)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Google OAuth Client ID (optional)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ==========================================
# SHIPROCKET LOGISTICS & SHIPPING FULFILLMENT
# ==========================================
SHIPROCKET_TOKEN=your_shiprocket_bearer_token_here
PICKUP_LOCATION_ID=Primary

# Optional: Service Role Key for Backend Admin DB Access
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

